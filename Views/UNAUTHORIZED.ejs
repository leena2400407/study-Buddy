<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Unauthorized Access</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      font-family: "Segoe UI", Arial, sans-serif;
      background:
        radial-gradient(circle at top left, rgba(78, 70, 229, 0.35), transparent 35%),
        radial-gradient(circle at bottom right, rgba(14, 165, 233, 0.25), transparent 35%),
        linear-gradient(135deg, #020617, #0f172a 45%, #111827);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      overflow: hidden;
    }

    .error-glow {
      position: fixed;
      width: 420px;
      height: 420px;
      border-radius: 50%;
      background: rgba(99, 102, 241, 0.22);
      filter: blur(80px);
      animation: floatGlow 6s ease-in-out infinite alternate;
      z-index: 0;
    }

    .error-glow.one {
      top: -120px;
      left: -100px;
    }

    .error-glow.two {
      right: -120px;
      bottom: -120px;
      background: rgba(14, 165, 233, 0.18);
      animation-delay: 1.5s;
    }

    .error-card {
      position: relative;
      z-index: 2;
      width: min(620px, 100%);
      padding: 44px 34px;
      text-align: center;
      border-radius: 28px;
      background: rgba(15, 23, 42, 0.74);
      border: 1px solid rgba(148, 163, 184, 0.22);
      box-shadow:
        0 30px 90px rgba(0, 0, 0, 0.45),
        inset 0 1px 0 rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(18px);
    }

    .error-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 9px 18px;
      margin-bottom: 20px;
      border-radius: 999px;
      background: rgba(239, 68, 68, 0.14);
      border: 1px solid rgba(248, 113, 113, 0.28);
      color: #fecaca;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 1.6px;
      text-transform: uppercase;
    }

    .error-code {
      font-size: clamp(72px, 16vw, 140px);
      font-weight: 900;
      line-height: 0.9;
      margin-bottom: 20px;
      background: linear-gradient(135deg, #ffffff, #93c5fd, #c4b5fd);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      text-shadow: 0 0 42px rgba(147, 197, 253, 0.18);
    }

    h1 {
      font-size: clamp(28px, 5vw, 44px);
      margin-bottom: 14px;
      letter-spacing: -1px;
    }

    p {
      color: #cbd5e1;
      font-size: 17px;
      line-height: 1.7;
      max-width: 460px;
      margin: 0 auto 28px;
    }

    .actions {
      display: flex;
      justify-content: center;
      gap: 14px;
      flex-wrap: wrap;
    }

    .btn {
      border: none;
      outline: none;
      cursor: pointer;
      text-decoration: none;
      padding: 13px 22px;
      border-radius: 999px;
      font-size: 15px;
      font-weight: 800;
      transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
    }

    .btn-primary {
      color: #020617;
      background: linear-gradient(135deg, #bfdbfe, #c4b5fd);
      box-shadow: 0 14px 34px rgba(147, 197, 253, 0.22);
    }

    .btn-secondary {
      color: #e5e7eb;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(148, 163, 184, 0.24);
    }

    .btn:hover {
      transform: translateY(-3px);
    }

    .btn-primary:hover {
      box-shadow: 0 18px 42px rgba(147, 197, 253, 0.34);
    }

    @keyframes floatGlow {
      from {
        transform: translate3d(0, 0, 0) scale(1);
      }

      to {
        transform: translate3d(35px, 28px, 0) scale(1.12);
      }
    }

    @media (max-width: 520px) {
      .error-card {
        padding: 36px 22px;
      }

      .actions {
        flex-direction: column;
      }

      .btn {
        width: 100%;
      }
    }
  </style>
</head>

<body>
  <div class="error-glow one"></div>
  <div class="error-glow two"></div>

  <main class="error-card">
    <div class="error-badge">Access Denied</div>

    <div class="error-code">403</div>

    <h1>Unauthorized Access</h1>

    <p>
      You do not have permission to open this page.
      Please go back or return to the main Study Buddy page.
    </p>

    <div class="actions">
      <a href="/cylinder" class="btn btn-primary">Back to Cylinder</a>
      <a href="/" class="btn btn-secondary">Go Home</a>
    </div>
  </main>
</body>
</html>