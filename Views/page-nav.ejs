<%
  const navBackHref = typeof backHref !== "undefined" ? backHref : "/cylinder#cylinder";
  const navActive = typeof activePage !== "undefined" ? activePage : "";
  const loggedUser = typeof user !== "undefined" ? user : null;
  const currentLang = typeof lang !== "undefined" ? lang : "en";

  const pagePaths = {
    home: "/",
    events: "/events",
    games: "/game-landing-page",
    resources: "/resources",
    matching: "/matching",
    ai: "/ai",
    guide: "/freshman-guid",
    profile: "/profile#info"
  };

  const currentPath = pagePaths[navActive] || navBackHref || "/cylinder";

  const translate = typeof t === "function"
    ? t
    : function (key, fallback) {
        const fallbackText = {
          "nav.home": "Home",
          "nav.profile": "Profile",
          "nav.login": "Login",
          "nav.logout": "Logout",
          "nav.events": "Events",
          "nav.game": "Games",
          "nav.resources": "Resources",
          "nav.matching": "Match",
          "nav.ai": "AI Chat",
          "nav.guide": "Freshman"
        };

        return fallbackText[key] || fallback || key;
      };
%>

<nav class="sb-page-nav" id="sbPageNav">
  <div class="sb-page-nav__panel">

    <a class="sb-page-nav__link <%= navActive === 'home' ? 'is-active' : '' %>" href="/">
      <%= translate("nav.home", "Home") %>
    </a>

    <a class="sb-page-nav__link <%= navActive === 'events' ? 'is-active' : '' %>" href="/events">
      <%= translate("nav.events", "Events") %>
    </a>

    <a class="sb-page-nav__link <%= navActive === 'games' ? 'is-active' : '' %>" href="/game-landing-page">
      <%= translate("nav.game", "Games") %>
    </a>

    <a class="sb-page-nav__link <%= navActive === 'resources' ? 'is-active' : '' %>" href="/resources">
      <%= translate("nav.resources", "Resources") %>
    </a>

    <a class="sb-page-nav__link <%= navActive === 'matching' ? 'is-active' : '' %>" href="/matching">
      <%= translate("nav.matching", "Match") %>
    </a>

    <a class="sb-page-nav__link <%= navActive === 'ai' ? 'is-active' : '' %>" href="/ai">
      <%= translate("nav.ai", "AI Chat") %>
    </a>

    <a class="sb-page-nav__link <%= navActive === 'guide' ? 'is-active' : '' %>" href="/freshman-guid">
      <%= translate("nav.guide", "Freshman") %>
    </a>

    <div class="sb-page-nav__language">
      <a
        class="sb-page-nav__lang-btn <%= currentLang === 'en' ? 'is-active' : '' %>"
        href="/change-language/en?redirect=<%= encodeURIComponent(currentPath) %>"
      >
        EN
      </a>

      <a
        class="sb-page-nav__lang-btn <%= currentLang === 'ar' ? 'is-active' : '' %>"
        href="/change-language/ar?redirect=<%= encodeURIComponent(currentPath) %>"
      >
        AR
      </a>
    </div>

    <% if (loggedUser) { %>
      <a class="sb-page-nav__link <%= navActive === 'profile' ? 'is-active' : '' %>" href="/profile#info">
        <%= translate("nav.profile", "Profile") %>
      </a>

      <a class="sb-page-nav__link sb-page-nav__logout" href="/logout">
        <%= translate("nav.logout", "Logout") %>
      </a>
    <% } else { %>
      <a class="sb-page-nav__link" href="/login">
        <%= translate("nav.login", "Login") %>
      </a>
    <% } %>

  </div>

  <a class="sb-page-nav__close" href="<%= navBackHref %>">×</a>

  <button class="sb-page-nav__toggle" type="button" aria-label="Open navigation">
    <span class="sb-page-nav__icon">
      <span class="sb-page-nav__line sb-page-nav__line--one"></span>
      <span class="sb-page-nav__line sb-page-nav__line--two"></span>
      <span class="sb-page-nav__line sb-page-nav__line--three"></span>
    </span>
  </button>
</nav>