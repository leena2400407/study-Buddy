<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>
    <%= typeof pageTitle !== "undefined" ? pageTitle : "AI Chatbot" %>
  </title>

  <link rel="stylesheet" href="/css/ai.css" />
</head>

<body>
  <div class="visual-world"></div>

  <nav class="signal-nav" aria-label="Hidden controls">
    <button class="signal-dot" type="button" aria-label="Open controls">
      <span></span>
    </button>

    <div class="signal-menu">
      <button id="themeToggle" type="button">soft mode</button>
      <button id="clearBtn" type="button">clear</button>
      <button type="button" onclick="window.location.href='/cylinder#cylinder'">exit</button>
    </div>
  </nav>

  <main class="ai-app">
    <aside class="identity-panel ai-side-panel">
      <div class="ai-side-inner">
        <div class="ai-side-top">
          <p class="eyebrow">AI Chatbot</p>

          <div class="ai-model-badge">
            <span></span>
            online
          </div>
        </div>

        <div class="ai-core-card">
          <div class="ai-rings">
            <span></span>
            <span></span>
            <span></span>
          </div>

          <div class="ai-core">
            <span>AI</span>
          </div>
        </div>

        <div class="ai-side-title">
          <h1>
            A clean space<br />
            for thinking.
          </h1>

          <p>
            Ask questions, understand lessons, explain code, summarize topics,
            and prepare with a focused chatbot experience.
          </p>
        </div>

        <div class="ai-mini-tags">
          <span>study</span>
          <span>code</span>
          <span>summary</span>
          <span>exam</span>
        </div>
      </div>
    </aside>

    <section class="chat-studio">
      <header class="chat-header">
        <div>
          <p class="chat-label">live session</p>
          <h2>AI Chatbot</h2>
        </div>

        <div class="status-pill">
          <span></span>
          <p id="chatStatus">online</p>
        </div>
      </header>

      <section id="startScreen" class="start-screen">
        <div class="start-symbol">
          <span>✦</span>
        </div>

        <p class="eyebrow">choose a starting point</p>

        <h3>What do you want to understand?</h3>

        <p class="start-copy">
          Start with a shortcut or write your own question. The chat is designed
          to stay focused, smooth, and presentation-ready.
        </p>

        <div class="prompt-grid">
          <button type="button" data-prompt="Summarize this topic for my exam in simple steps.">
            <span>summary</span>
            <strong>Make it simple</strong>
            <small>Turn large content into clear points.</small>
          </button>

          <button type="button" data-prompt="Explain this code step by step and tell me what each part does.">
            <span>coding</span>
            <strong>Explain code</strong>
            <small>Understand logic and structure.</small>
          </button>

          <button type="button" data-prompt="Give me MCQ questions to test my understanding.">
            <span>exam</span>
            <strong>Test me</strong>
            <small>Practice with focused questions.</small>
          </button>
        </div>

        <button id="startBtn" class="start-btn" type="button">
          enter chat
        </button>
      </section>

      <section id="chatUi" class="chat-ui hidden">
        <div id="chatBox" class="chat-box"></div>

        <form id="chatForm" class="chat-form">
          <div class="input-shell">
            <textarea
              id="messageInput"
              placeholder="Ask anything..."
              rows="1"
              autocomplete="off"
              required
            ></textarea>

            <div class="input-meta">
              <span id="charCount">0 characters</span>
              <span>Enter to send • Shift + Enter for new line</span>
            </div>
          </div>

          <button id="sendBtn" class="send-btn" type="submit" disabled>
            send
          </button>
        </form>
      </section>
    </section>
  </main>

  <script src="/javaScript/ai.js"></script>
</body>
</html>