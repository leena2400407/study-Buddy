<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Study Buddy - Cylinder</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700&family=Sora:wght@600;700;800&display=swap" rel="stylesheet">

  <script>
    /*
      Apply saved cylinder theme before CSS paints, so there is no white/light flash.
    */
    (function () {
      try {
        if (localStorage.getItem('studyBuddyCylinderTheme') === 'dark') {
          document.documentElement.classList.add('cylinder-dark-theme-root');
        }
      } catch (error) {
        // Ignore localStorage errors
      }
    })();
  </script>

  <link rel="stylesheet" href="/css/home.css">
</head>

<body class="cylinder-body">

  <div id="bg-effects">
    <span class="aurora aurora--1"></span>
    <span class="aurora aurora--2"></span>
    <span class="aurora aurora--3"></span>
    <div class="grid-veil"></div>
  </div>

  <div id="intro-logo" style="display: none;">
    <img src="/assests/images/WhatsApp_Image_2026-03-19_at_11.23.23_PM-removebg-preview.png"
         alt="Study Buddy">
  </div>

  <div id="features-page" style="display: flex;">
    <div class="scene" id="cylinder-scene" style="display: flex;">

      <!-- NEW HORIZONTAL SCROLL NAV -->
      <nav class="top-nav">
        <div class="cylinder-scroll-nav" id="cylinderScrollNav">

          <button
            class="nav-cylinder-toggle nav-menu-morph"
            id="navCylinderToggle"
            type="button"
            aria-label="Open navigation"
            aria-expanded="false"
          >
            <span class="nav-menu-morph__box" aria-hidden="true">
              <span class="nav-menu-morph__line nav-menu-morph__line--one"></span>
              <span class="nav-menu-morph__line nav-menu-morph__line--two"></span>
              <span class="nav-menu-morph__line nav-menu-morph__line--three"></span>
            </span>
          </button>

          <div class="nav-scroll-panel" id="navScrollPanel">

            <div class="profile-dropdown">
              <button class="profile-link" onclick="toggleProfile()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
                <%= t("nav.profile") %>
              </button>

              <div id="profileCard" class="profile-card">
                <% if (user && user.avatar) { %>
                  <img src="<%= user.avatar %>" alt="Student Profile Avatar" class="profile-avatar-img">
                <% } else { %>
                  <img src="/assests/images/profile.png" alt="Student Profile Avatar" class="profile-avatar-img">
                <% } %>

                <% if (user) { %>
                  <h3 id="dropdown-name" class="profile-name">
                    <%= user.fullName || user.username || "N/A" %>
                  </h3>

                  <p class="profile-info">
                   <strong><%= t("profile.gender") %>:</strong>
                    <span id="dropdown-gender"><%= user.gender || "N/A" %></span>
                  </p>

                  <p class="profile-info">
                <strong><%= t("profile.university") %>:</strong>
                    <span id="dropdown-university"><%= user.university || "N/A" %></span>
                  </p>

                  <p class="profile-info">
                  <strong><%= t("profile.major") %>:</strong>
                    <span id="dropdown-major"><%= user.major || "N/A" %></span>
                  </p>

                  <p class="profile-info">
                   <strong><%= t("profile.email") %>:</strong>
                    <span id="dropdown-email"><%= user.email || "N/A" %></span>
                  </p>

                  <a href="/profile#info" class="full-profile-btn"><%= t("profile.viewFullProfile") %></a>

                  <button onclick="logout()" class="logout-btn">
                   <%= t("nav.logout") %>
                  </button>
                <% } else { %>
                  <h3 class="profile-name"><%= t("profile.guest") %></h3>

                  <p class="profile-info">
                 <%= t("profile.loginMessage") %>
                  </p>

                  <a href="/login" class="full-profile-btn">
                  <%= t("nav.login") %>
                  </a>
                <% } %>
              </div>
            </div>

            <div class="dropdown">
              <button class="dropbtn" onclick="toggleDropdown()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                  <path d="M3 5V19A9 3 0 0 0 21 19V5"></path>
                  <ellipse cx="12" cy="19" rx="9" ry="3"></ellipse>
                </svg>
             <%= t("nav.cylinder") %> ▾
              </button>

              <div id="myDropdown" class="dropdown-content">
<a href="/events" style="color: white; padding: 12px 16px; text-decoration: none; display: block; text-align: center;"><%= t("nav.events") %></a>

<a href="/game" style="color: white; padding: 12px 16px; text-decoration: none; display: block;"><%= t("nav.game") %></a>

<a href="/resources" style="color: white; padding: 12px 16px; text-decoration: none; display: block;"><%= t("nav.resources") %></a>

<a href="/matching" style="color: white; padding: 12px 16px; text-decoration: none; display: block;"><%= t("nav.matching") %></a>

<a href="/ai" style="color: white; padding: 12px 16px; text-decoration: none; display: block;"><%= t("nav.ai") %></a>

<a href="/freshman-guide" style="color: white; padding: 12px 16px; text-decoration: none; display: block;"><%= t("nav.guide") %></a>
              </div>
            </div>

            <% if (lang === "en") { %>
  <div class="login-link" onclick="window.location.href='/change-language/ar'">
    Arabic
  </div>
<% } else { %>
  <div class="login-link" onclick="window.location.href='/change-language/en'">
    English
  </div>
<% } %>

            <div class="home-link" onclick="window.location.href='/'">
            <%= t("nav.home") %>
            </div>

            <% if (!user) { %>
              <div class="login-link" onclick="window.location.href='/login'">
                <%= t("nav.login") %>
              </div>
            <% } else { %>
              <div class="login-link" onclick="logout()">
               <%= t("nav.logout") %>
              </div>
            <% } %>

            <!-- THEME BUTTON: sun / moon switch at the very right of the navbar -->
            <button class="theme-toggle" id="themeToggle" type="button" aria-label="Switch to dark theme" aria-pressed="false">
              <span class="theme-toggle__track">
                <span class="theme-toggle__icon theme-toggle__sun" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2"></path>
                    <path d="M12 20v2"></path>
                    <path d="M4.93 4.93l1.41 1.41"></path>
                    <path d="M17.66 17.66l1.41 1.41"></path>
                    <path d="M2 12h2"></path>
                    <path d="M20 12h2"></path>
                    <path d="M4.93 19.07l1.41-1.41"></path>
                    <path d="M17.66 6.34l1.41-1.41"></path>
                  </svg>
                </span>

                <span class="theme-toggle__icon theme-toggle__moon" aria-hidden="true">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M21 14.7A8.7 8.7 0 0 1 9.3 3a7.1 7.1 0 1 0 11.7 11.7Z"></path>
                  </svg>
                </span>

                <span class="theme-toggle__knob"></span>
              </span>
            </button>

          </div>
        </div>
      </nav>

      <div class="Cylinder" id="Cylinder">

 <div class="Cylinder__cell" id="event">
  <h3><%= t("cylinder.eventsTitle") %></h3>
  <p style="font-size: 1.2rem; margin-top: 10px;"><%= t("cylinder.eventsDesc") %></p>
</div>

<div class="Cylinder__cell" id="game">
  <h3><%= t("cylinder.gameTitle") %></h3>
</div>

<div class="Cylinder__cell" id="resources-card">
  <h3><%= t("cylinder.resourcesTitle") %></h3>
  <p style="font-size: 1.2rem;"><%= t("cylinder.resourcesDesc") %></p>
</div>

<div class="Cylinder__cell" id="btn-matching">
  <h3><%= t("cylinder.matchTitle") %></h3>
  <p style="font-size: 1.2rem;"><%= t("cylinder.matchDesc") %></p>
</div>

<div class="Cylinder__cell" id="ai">
  <h3><%= t("cylinder.aiTitle") %></h3>
  <p style="font-size: 1.2rem;"><%= t("cylinder.aiDesc") %></p>
</div>

<div class="Cylinder__cell" id="guid">
  <h3><%= t("cylinder.guideTitle") %></h3>
  <p style="font-size: 1.2rem;"><%= t("cylinder.guideDesc") %></p>
</div>

      </div>
    </div>

    <div class="controls" id="controls" style="display: none;">
      <button class="control-btn" id="prev-btn">◀ PREV</button>
      <button class="control-btn" id="next-btn">NEXT ▶</button>
    </div>
  </div>

  <script src="/javaScript/home.js"></script>

  <script>
    function logout() {
      window.location.href = "/logout";
    }
  </script>

</body>
</html>