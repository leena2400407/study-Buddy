<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>404 - Page Not Found</title>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: Arial, sans-serif;
      background: radial-gradient(circle at top, #1e1b4b, #050510);
      color: white;
      text-align: center;
    }

    .box {
      max-width: 520px;
      padding: 40px;
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.16);
      box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
      backdrop-filter: blur(18px);
    }

    h1 {
      font-size: 90px;
      margin: 0;
      color: #38bdf8;
    }

    h2 {
      margin: 10px 0;
      font-size: 28px;
    }

    p {
      color: #cbd5e1;
      line-height: 1.6;
    }

    a {
      display: inline-block;
      margin-top: 22px;
      padding: 13px 24px;
      border-radius: 999px;
      text-decoration: none;
      color: white;
      font-weight: bold;
      background: linear-gradient(135deg, #38bdf8, #a855f7);
    }
  </style>
</head>
<body>
  <div class="box">
    <h1>404</h1>
    <h2>Page Not Found</h2>
    <p>The page you are looking for does not exist.</p>
    <a href="/">Back to Home</a>
  </div>
</body>
</html>