<!DOCTYPE html>
<html lang="<%= typeof lang !== "undefined" ? lang : "en" %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Study Buddy - Cylinder</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700&family=Sora:wght@600;700;800&display=swap" rel="stylesheet">

  <script>
    /*
      Apply saved cylinder theme before CSS paints, so there is no white/light flash.
    */
    (function () {
      try {
        if (localStorage.getItem("studyBuddyCylinderTheme") === "dark") {
          document.documentElement.classList.add("cylinder-dark-theme-root");
        }
      } catch (error) {
        // Ignore localStorage errors
      }
    })();
  </script>

  <link rel="stylesheet" href="/css/home.css">
</head>

<%
  const tr = typeof t === "function"
    ? t
    : function (key, fallback) {
        return fallback || key;
      };

  const currentLang = typeof lang !== "undefined" ? lang : "en";
%>

<body class="cylinder-body" data-lang="<%= currentLang %>">

  <div id="bg-effects">
    <span class="aurora aurora--1"></span>
    <span class="aurora aurora--2"></span>
    <span class="aurora aurora--3"></span>
    <div class="grid-veil"></div>
  </div>

  <div id="intro-logo" style="display: none;">
    <img
      src="/assests/images/WhatsApp_Image_2026-03-19_at_11.23.23_PM-removebg-preview.png"
      alt="Study Buddy"
    >
  </div>

  <div id="features-page" style="display: flex;">
    <div class="scene" id="cylinder-scene" style="display: flex;">

      <!-- NAVBAR -->
      <nav class="top-nav">
        <div class="cylinder-scroll-nav" id="cylinderScrollNav">

          <button
            class="nav-cylinder-toggle nav-menu-morph"
            id="navCylinderToggle"
            type="button"
            aria-label="Open navigation"
            aria-expanded="false"
          >
            <span class="nav-menu-morph__box" aria-hidden="true">
              <span class="nav-menu-morph__line nav-menu-morph__line--one"></span>
              <span class="nav-menu-morph__line nav-menu-morph__line--two"></span>
              <span class="nav-menu-morph__line nav-menu-morph__line--three"></span>
            </span>
          </button>

          <div class="nav-scroll-panel" id="navScrollPanel">

            <!-- PROFILE -->
            <div class="profile-dropdown">
              <button class="profile-link" onclick="toggleProfile()" type="button">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
                <%= tr("nav.profile", "Profile") %>
              </button>

              <div id="profileCard" class="profile-card">
                <% if (user && user.avatar) { %>
                  <img src="<%= user.avatar %>" alt="Student Profile Avatar" class="profile-avatar-img">
                <% } else { %>
                  <img src="/assests/images/profile.png" alt="Student Profile Avatar" class="profile-avatar-img">
                <% } %>

                <% if (user) { %>
                  <h3 id="dropdown-name" class="profile-name">
                    <%= user.fullName || user.username || "N/A" %>
                  </h3>

                  <p class="profile-info">
                    <strong><%= tr("profile.gender", "Gender") %>:</strong>
                    <span id="dropdown-gender"><%= user.gender || "N/A" %></span>
                  </p>

                  <p class="profile-info">
                    <strong><%= tr("profile.university", "University") %>:</strong>
                    <span id="dropdown-university"><%= user.university || "N/A" %></span>
                  </p>

                  <p class="profile-info">
                    <strong><%= tr("profile.major", "Major") %>:</strong>
                    <span id="dropdown-major"><%= user.major || "N/A" %></span>
                  </p>

                  <p class="profile-info">
                    <strong><%= tr("profile.email", "Email") %>:</strong>
                    <span id="dropdown-email"><%= user.email || "N/A" %></span>
                  </p>

                  <a href="/profile#info" class="full-profile-btn">
                    <%= tr("profile.viewFullProfile", "View Full Profile") %>
                  </a>

                  <button onclick="logout()" class="logout-btn" type="button">
                    <%= tr("nav.logout", "Logout") %>
                  </button>
                <% } else { %>
                  <h3 class="profile-name">
                    <%= tr("profile.guest", "Guest") %>
                  </h3>

                  <p class="profile-info">
                    <%= tr("profile.loginMessage", "Please login to view your profile.") %>
                  </p>

                  <a href="/login" class="full-profile-btn">
                    <%= tr("nav.login", "Login") %>
                  </a>
                <% } %>
              </div>
            </div>

            <!-- DROPDOWN -->
            <div class="dropdown">
              <button class="dropbtn" onclick="toggleDropdown()" type="button">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                  <path d="M3 5V19A9 3 0 0 0 21 19V5"></path>
                  <ellipse cx="12" cy="19" rx="9" ry="3"></ellipse>
                </svg>
                <%= tr("nav.cylinder", "Cylinder") %> ▾
              </button>

              <div id="myDropdown" class="dropdown-content">
                <a href="/events" style="color: white; padding: 12px 16px; text-decoration: none; display: block; text-align: center;">
                  <%= tr("nav.events", "Events") %>
                </a>

                <a href="/game-landing-page" style="color: white; padding: 12px 16px; text-decoration: none; display: block; text-align: center;">
                  <%= tr("nav.game", "Games") %>
                </a>

                <a href="/resources" style="color: white; padding: 12px 16px; text-decoration: none; display: block; text-align: center;">
                  <%= tr("nav.resources", "Resources") %>
                </a>

                <a href="/matching" style="color: white; padding: 12px 16px; text-decoration: none; display: block; text-align: center;">
                  <%= tr("nav.matching", "Matching") %>
                </a>

                <a href="/ai" style="color: white; padding: 12px 16px; text-decoration: none; display: block; text-align: center;">
                  <%= tr("nav.ai", "AI Assistant") %>
                </a>

                <a href="/freshman-guid" style="color: white; padding: 12px 16px; text-decoration: none; display: block; text-align: center;">
                  <%= tr("nav.guide", "Freshman Guide") %>
                </a>
              </div>
            </div>

            <!-- LANGUAGE BUTTON -->
            <% if (currentLang === "en") { %>
              <div class="login-link language-nav-btn" onclick="window.location.href='/change-language/ar?redirect=/cylinder'">
                Arabic
              </div>
              <% } else { %>
              <div class="login-link language-nav-btn" onclick="window.location.href='/change-language/en?redirect=/cylinder'">
                English
              </div>
            <% } %>

            <!-- HOME -->
            <div class="home-link" onclick="window.location.href='/'">
              <%= tr("nav.home", "Home") %>
            </div>

            <!-- LOGIN / LOGOUT -->
            <% if (!user) { %>
              <div class="login-link" onclick="window.location.href='/login'">
                <%= tr("nav.login", "Login") %>
              </div>
            <% } else { %>
              <div class="login-link" onclick="logout()">
                <%= tr("nav.logout", "Logout") %>
              </div>
            <% } %>

            <!-- THEME BUTTON -->
            <button class="theme-toggle" id="themeToggle" type="button" aria-label="Switch to dark theme" aria-pressed="false">
              <span class="theme-toggle__track">

                <span class="theme-toggle__icon theme-toggle__sun" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2"></path>
                    <path d="M12 20v2"></path>
                    <path d="M4.93 4.93l1.41 1.41"></path>
                    <path d="M17.66 17.66l1.41 1.41"></path>
                    <path d="M2 12h2"></path>
                    <path d="M20 12h2"></path>
                    <path d="M4.93 19.07l1.41-1.41"></path>
                    <path d="M17.66 6.34l1.41-1.41"></path>
                  </svg>
                </span>

                <span class="theme-toggle__icon theme-toggle__moon" aria-hidden="true">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M21 14.7A8.7 8.7 0 0 1 9.3 3a7.1 7.1 0 1 0 11.7 11.7Z"></path>
                  </svg>
                </span>

                <span class="theme-toggle__knob"></span>
              </span>
            </button>

          </div>
        </div>
      </nav>

      <!-- CYLINDER CARDS -->
      <div class="Cylinder" id="Cylinder">

        <!-- EVENT CARD -->
        <div class="Cylinder__cell" id="event" data-href="/events">
          <div class="cell__media" style="background-image: url('/assests/images/event.png');"></div>
          <div class="cell__overlay"></div>
          <div class="cell__content">
            <h3><%= tr("cylinder.eventsTitle", "Events") %></h3>
            <p><%= tr("cylinder.eventsDesc", "Join campus events, tournaments, and activities.") %></p>
          </div>
        </div>

        <!-- GAME CARD -->
        <div class="Cylinder__cell" id="game" data-href="/game-landing-page">
          <div class="cell__media" style="background-image: url('/assests/images/game.png');"></div>
          <div class="cell__overlay"></div>
          <div class="cell__content">
            <h3><%= tr("cylinder.gameTitle", "Games") %></h3>
            <p><%= tr("cylinder.gameDesc", "Play and compete with your friends.") %></p>
          </div>
        </div>

        <!-- RESOURCES CARD -->
        <div class="Cylinder__cell" id="resources-card" data-href="/resources">
          <div class="cell__media" style="background-image: url('/assests/images/resources.png');"></div>
          <div class="cell__overlay"></div>
          <div class="cell__content">
            <h3><%= tr("cylinder.resourcesTitle", "Resources") %></h3>
            <p><%= tr("cylinder.resourcesDesc", "Find useful academic materials and student resources.") %></p>
          </div>
        </div>

        <!-- MATCHING CARD -->
        <div class="Cylinder__cell" id="btn-matching" data-href="/matching">
          <div class="cell__media" style="background-image: url('/assests/images/matching.png');"></div>
          <div class="cell__overlay"></div>
          <div class="cell__content">
            <h3><%= tr("cylinder.matchTitle", "Matching") %></h3>
            <p><%= tr("cylinder.matchDesc", "Find the perfect study partner from your university and major.") %></p>
          </div>
        </div>

        <!-- AI CARD -->
        <div class="Cylinder__cell" id="ai" data-href="/ai">
          <div class="cell__media" style="background-image: url('/assests/images/ai.png');"></div>
          <div class="cell__overlay"></div>
          <div class="cell__content">
            <h3><%= tr("cylinder.aiTitle", "AI Assistant") %></h3>
            <p><%= tr("cylinder.aiDesc", "Ask Study Buddy AI for help anytime.") %></p>
          </div>
        </div>

        <!-- FRESHMAN GUIDE CARD -->
        <div class="Cylinder__cell" id="guid" data-href="/freshman-guid">
          <div class="cell__media" style="background-image: url('/assests/images/freshman.png');"></div>
          <div class="cell__overlay"></div>
          <div class="cell__content">
            <h3><%= tr("cylinder.guideTitle", "Freshman Guide") %></h3>
            <p><%= tr("cylinder.guideDesc", "Everything new students need to know.") %></p>
          </div>
        </div>

      </div>
    </div>

    <div class="controls" id="controls" style="display: none;">
      <button class="control-btn" id="prev-btn" type="button">◀ PREV</button>
      <button class="control-btn" id="next-btn" type="button">NEXT ▶</button>
    </div>
  </div>

  <script src="/javaScript/home.js"></script>

  <script>
    function logout() {
      window.location.href = "/logout";
    }
  </script>

</body>
</html>