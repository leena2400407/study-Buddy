<%
  const navBackHref = typeof backHref !== "undefined" ? backHref : "/cylinder#cylinder";
  const navActive = typeof activePage !== "undefined" ? activePage : "";
  const loggedUser = typeof user !== "undefined" ? user : null;
%>

<nav class="sb-page-nav notranslate" id="sbPageNav" translate="no">
  <div class="sb-page-nav__panel">

    <a
      class="sb-page-nav__link <%= navActive === 'home' ? 'is-active' : '' %>"
      href="/"
      data-en="Home"
      data-ar="&#1575;&#1604;&#1585;&#1574;&#1610;&#1587;&#1610;&#1577;"
    >
      Home
    </a>

    <a
      class="sb-page-nav__link <%= navActive === 'events' ? 'is-active' : '' %>"
      href="/events"
      data-en="Events"
      data-ar="&#1575;&#1604;&#1601;&#1593;&#1575;&#1604;&#1610;&#1575;&#1578;"
    >
      Events
    </a>

    <a
      class="sb-page-nav__link <%= navActive === 'games' ? 'is-active' : '' %>"
      href="/game-landing-page"
      data-en="Games"
      data-ar="&#1575;&#1604;&#1571;&#1604;&#1593;&#1575;&#1576;"
    >
      Games
    </a>

    <a
      class="sb-page-nav__link <%= navActive === 'resources' ? 'is-active' : '' %>"
      href="/resources"
      data-en="Resources"
      data-ar="&#1575;&#1604;&#1605;&#1589;&#1575;&#1583;&#1585;"
    >
      Resources
    </a>

    <a
      class="sb-page-nav__link <%= navActive === 'matching' ? 'is-active' : '' %>"
      href="/matching"
      data-en="Matching"
      data-ar="&#1575;&#1604;&#1578;&#1608;&#1575;&#1601;&#1602; &#1575;&#1604;&#1583;&#1585;&#1575;&#1587;&#1610;"
    >
      Matching
    </a>

    <a
      class="sb-page-nav__link <%= navActive === 'ai' ? 'is-active' : '' %>"
      href="/ai"
      data-en="AI Assistant"
      data-ar="&#1575;&#1604;&#1605;&#1587;&#1575;&#1593;&#1583; &#1575;&#1604;&#1584;&#1603;&#1610;"
    >
      AI Assistant
    </a>

    <a
      class="sb-page-nav__link <%= navActive === 'guide' ? 'is-active' : '' %>"
      href="/freshman-guid"
      data-en="Student Guide"
      data-ar="&#1583;&#1604;&#1610;&#1604; &#1575;&#1604;&#1591;&#1604;&#1575;&#1576;"
    >
      Student Guide
    </a>

    <div class="sb-page-nav__language">
      <button type="button" id="langToggleBtn" class="sb-page-nav__lang-btn notranslate" translate="no">
        AR
      </button>
    </div>

    <% if (loggedUser) { %>
      <a
        class="sb-page-nav__link <%= navActive === 'profile' ? 'is-active' : '' %>"
        href="/profile#info"
        data-en="Profile"
        data-ar="&#1575;&#1604;&#1605;&#1604;&#1601;"
      >
        Profile
      </a>

      <a
        class="sb-page-nav__link sb-page-nav__logout"
        href="/logout"
        data-en="Logout"
        data-ar="&#1582;&#1585;&#1608;&#1580;"
      >
        Logout
      </a>
    <% } else { %>
      <a
        class="sb-page-nav__link"
        href="/login"
        data-en="Login"
        data-ar="&#1583;&#1582;&#1608;&#1604;"
      >
        Login
      </a>
    <% } %>

  </div>

  <a class="sb-page-nav__close notranslate" href="<%= navBackHref %>" translate="no">×</a>

  <button class="sb-page-nav__toggle notranslate" type="button" aria-label="Open navigation" translate="no">
    <span class="sb-page-nav__icon">
      <span class="sb-page-nav__line sb-page-nav__line--one"></span>
      <span class="sb-page-nav__line sb-page-nav__line--two"></span>
      <span class="sb-page-nav__line sb-page-nav__line--three"></span>
    </span>
  </button>
</nav>

<div id="google_translate_element" class="google-translate-box"></div>

<script>
  (function () {
    function setCookie(name, value) {
      document.cookie = name + "=" + value + "; path=/; SameSite=Lax";

      if (window.location.hostname.indexOf(".") !== -1) {
        document.cookie =
          name +
          "=" +
          value +
          "; path=/; domain=" +
          window.location.hostname +
          "; SameSite=Lax";

        document.cookie =
          name +
          "=" +
          value +
          "; path=/; domain=." +
          window.location.hostname +
          "; SameSite=Lax";
      }
    }

    function clearCookie(name) {
      document.cookie = name + "=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";

      if (window.location.hostname.indexOf(".") !== -1) {
        document.cookie =
          name +
          "=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=" +
          window.location.hostname;

        document.cookie =
          name +
          "=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=." +
          window.location.hostname;
      }
    }

    try {
      var savedLang = localStorage.getItem("sbLang") || "en";

      document.documentElement.lang = savedLang;
      document.documentElement.dir = savedLang === "ar" ? "rtl" : "ltr";

      if (savedLang === "ar") {
        setCookie("googtrans", "/en/ar");
      } else {
        clearCookie("googtrans");
      }
    } catch (error) {
      // Ignore localStorage/cookie errors
    }
  })();

  window.googleTranslateElementInit = function () {
    new google.translate.TranslateElement(
      {
        pageLanguage: "en",
        includedLanguages: "ar",
        autoDisplay: false
      },
      "google_translate_element"
    );
  };
</script>

<script src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>