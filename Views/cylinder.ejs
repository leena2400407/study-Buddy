<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Study Buddy - Cylinder</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700&family=Sora:wght@600;700;800&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/home.css">
</head>

<body class="cylinder-body">

  <div id="bg-effects">
    <span class="aurora aurora--1"></span>
    <span class="aurora aurora--2"></span>
    <span class="aurora aurora--3"></span>
    <div class="grid-veil"></div>
  </div>

  <div id="intro-logo" style="display: none;">
  <img src="/assests/images/WhatsApp_Image_2026-03-19_at_11.23.23_PM-removebg-preview.png"
       alt="Study Buddy">
  </div>

  <div id="features-page" style="display: flex;">
  <div class="scene" id="cylinder-scene" style="display: flex;">
      <!-- NEW HORIZONTAL SCROLL NAV -->
      <nav class="top-nav">
        <div class="cylinder-scroll-nav" id="cylinderScrollNav">

          <button class="nav-cylinder-toggle" id="navCylinderToggle" type="button" aria-label="Open navigation">
            <svg class="nav-cylinder-icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <ellipse cx="12" cy="5" rx="8" ry="3"></ellipse>
              <path d="M4 5v14c0 1.66 3.58 3 8 3s8-1.34 8-3V5"></path>
              <ellipse cx="12" cy="19" rx="8" ry="3"></ellipse>
            </svg>
          </button>

          <div class="nav-scroll-panel" id="navScrollPanel">

            <div class="profile-dropdown">
              <button class="profile-link" onclick="toggleProfile()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
                Profile
              </button>

              <div id="profileCard" class="profile-card">
                <img
                  src="/assests/images/profile.png"
                  alt="Student Profile Avatar"
                  class="profile-avatar-img"
                >

                <% if (user) { %>
                  <h3 id="dropdown-name" class="profile-name">
                    <%= user.fullName || user.username || "N/A" %>
                  </h3>

                  <p class="profile-info">
                    <strong>Gender:</strong>
                    <span id="dropdown-gender"><%= user.gender || "N/A" %></span>
                  </p>

                  <p class="profile-info">
                    <strong>University:</strong>
                    <span id="dropdown-university"><%= user.university || "N/A" %></span>
                  </p>

                  <p class="profile-info">
                    <strong>Major:</strong>
                    <span id="dropdown-major"><%= user.major || "N/A" %></span>
                  </p>

                  <p class="profile-info">
                    <strong>Email:</strong>
                    <span id="dropdown-email"><%= user.email || "N/A" %></span>
                  </p>

                  <a href="/profile#info" class="full-profile-btn">View Full Profile</a>

                  <button onclick="logout()" class="logout-btn">
                    Logout
                  </button>
                <% } else { %>
                  <h3 class="profile-name">Guest</h3>

                  <p class="profile-info">
                    Please login to view your profile.
                  </p>

                  <a href="/login" class="full-profile-btn">
                    Login
                  </a>
                <% } %>
              </div>
            </div>

            <div class="dropdown">
              <button class="dropbtn" onclick="toggleDropdown()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                  <path d="M3 5V19A9 3 0 0 0 21 19V5"></path>
                  <ellipse cx="12" cy="19" rx="9" ry="3"></ellipse>
                </svg>
                Cylinder ▾
              </button>

              <div id="myDropdown" class="dropdown-content">
                <a href="/events">Events</a>
                <a href="/game-landing-page">Game</a>
                <a href="/resources">Resources</a>
                <a href="/matching">Match</a>
                <a href="/ai">AI Chat</a>
                <a href="/freshman-guid">Guide</a>
              </div>
            </div>

            <div class="home-link" onclick="window.location.href='/'">
              Home
            </div>

            <% if (!user) { %>
              <div class="login-link" onclick="window.location.href='/login'">
                Login
              </div>
            <% } else { %>
              <div class="login-link" onclick="logout()">
                Logout
              </div>
            <% } %>

          </div>
        </div>
      </nav>

      <div class="Cylinder" id="Cylinder">

        <div class="Cylinder__cell" id="event" data-href="/events">
          <div class="cell__media" style="background-image:url('/assests/images/new-event-bg-cy.avif')"></div>
          <div class="cell__overlay"></div>
          <div class="cell__content">
            <h3>EVENTS</h3>
            <p>Fun &amp; Sports</p>
          </div>
        </div>

        <div class="Cylinder__cell" id="game" data-href="/game-landing-page">
          <div class="cell__media" style="background-image:url('/assests/images/game-GB-CYlinder.jpg')"></div>
          <div class="cell__overlay"></div>
          <div class="cell__content">
            <h3>GAME</h3>
            <p>Play &amp; compete</p>
          </div>
        </div>

        <div class="Cylinder__cell" id="resources-card" data-href="/resources">
          <div class="cell__media" style="background-image:url('/assests/images/resources-bg-cyl.avif')"></div>
          <div class="cell__overlay"></div>
          <div class="cell__content">
            <h3>RESOURCES</h3>
            <p>Summaries &amp; Materials</p>
          </div>
        </div>

        <div class="Cylinder__cell" id="btn-matching" data-href="/matching">
          <div class="cell__media" style="background-image:url('/assests/images/matching.jpg.jpeg')"></div>
          <div class="cell__overlay"></div>
          <div class="cell__content">
            <h3>MATCH</h3>
            <p>Find your study buddy</p>
          </div>
        </div>

        <div class="Cylinder__cell" id="ai" data-href="/ai">
          <div class="cell__media" style="background-image:url('/assests/images/AI-GB-cy.webp')"></div>
          <div class="cell__overlay"></div>
          <div class="cell__content">
            <h3>AI CHAT</h3>
            <p>Your smart assistant</p>
          </div>
        </div>

        <div class="Cylinder__cell" id="guid" data-href="/freshman-guid">
          <div class="cell__media" style="background-image:url('/assests/images/guid.jpg.jpeg')"></div>
          <div class="cell__overlay"></div>
          <div class="cell__content">
            <h3>GUIDE</h3>
            <p>Freshmen Survival Kit</p>
          </div>
        </div>

      </div>
    </div>

    <div class="controls" id="controls" style="display: none;">
      <button class="control-btn" id="prev-btn">◀ PREV</button>
      <button class="control-btn" id="next-btn">NEXT ▶</button>
    </div>
  </div>

  <script src="/javaScript/home.js"></script>

  <script>
    function logout() {
      window.location.href = "/logout";
    }
  </script>

</body>
</html>