<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Study Buddy Matching</title>

  <link rel="stylesheet" href="/css/matching.css" />
</head>

<body class="matching-experience">
  <div class="match-bg-grid"></div>

  <div class="close-btn" onclick="window.location.href='/cylinder#cylinder'">✖</div>

  <section class="page-wrapper">

    <section class="hero-section reveal-on-scroll">
      <div class="hero-content">
        <p class="small-title">STUDY BUDDY MATCHING</p>

        <h1>
          Find Your Perfect<br>
          Study Partner
        </h1>

        <% if (!user) { %>
          <p class="login-warning">
            You must be logged in before searching for study matches.
          </p>
        <% } %>
      </div>
    </section>

    <div class="panel-card meet-rules-panel">
          <p class="section-label rules-label">MATCH RULES</p>

          <h2>Study Match Rules</h2>

          <div class="rules-list">
            <div class="rule-item">
              <p>1. You can only match with students from your same university and major.</p>
            </div>

            <div class="rule-item">
              <p>2. Match requests are sent by email and also appear inside the website.</p>
            </div>

            <div class="rule-item">
              <p>3. Chat opens only after the other student accepts your request.</p>
            </div>

            <div class="rule-item">
              <p>4. Use the chat for studying only.</p>
            </div>

            <div class="rule-item">
              <p>5. Be respectful and clear about what you need help with.</p>
            </div>
          </div>
        </div>
        <br>

    <section class="dashboard reveal-on-scroll">

      <div class="left-panel">

        <div class="panel-card my-profile">
          <p class="section-label">FIND MATCHES</p>
          <h2>Choose Your Subjects</h2>

          <div class="match-form">

            <label for="weakSubjectSelect">I need help with</label>
            <select id="weakSubjectSelect" class="subject-select">
              <option value="">Choose weak subject</option>
            </select>

            <button class="secondary-btn full-btn" type="button" onclick="addSelectedSubject('weak')">
              Add Weak Subject
            </button>

            <label for="strongSubjectSelect">I can help with</label>
            <select id="strongSubjectSelect" class="subject-select">
              <option value="">Choose strong subject</option>
            </select>

            <button class="secondary-btn full-btn" type="button" onclick="addSelectedSubject('strong')">
              Add Strong Subject
            </button>

            <div class="profile-section">
              <h4>I need help with</h4>
              <div id="profileWeak" class="subject-list empty-list">
                No weak subjects added yet.
              </div>
            </div>

            <div class="profile-section">
              <h4>I can teach</h4>
              <div id="profileStrong" class="subject-list empty-list">
                No strong subjects added yet.
              </div>
            </div>

            <button class="main-btn full-btn" type="button" onclick="saveStudyList()">
              Save My List
            </button>

            <button class="main-btn full-btn" type="button" onclick="searchMatches()">
              Search Matches
            </button>

            <button class="clear-btn full-btn" type="button" onclick="clearStudyList()">
              Clear List
            </button>

          </div>
        </div>
      </div>

      <div class="right-panel">

        <div class="panel-card matches-panel" id="matches-section">
          <div class="card-header">
            <div>
              <p class="section-label">AVAILABLE STUDENTS</p>
              <h2>Matching Results</h2>
            </div>
          </div>

          <div id="matchesGrid" class="matches-grid">
            <div class="empty-state-card">
              <div class="empty-icon">🔎</div>
              <h3>No search yet</h3>
              <p>Add subjects to your study list, save it, then search for matches.</p>
            </div>
          </div>
        </div>

        <div class="panel-card matches-panel">
          <div class="card-header">
            <div>
              <p class="section-label">REQUESTS</p>
              <h2>My Match Requests</h2>
            </div>
          </div>

          <div id="requestsGrid" class="matches-grid">
            <div class="empty-state-card small-empty">
              <div class="empty-icon">📩</div>
              <h3>No requests yet</h3>
              <p>Your sent, received, accepted, and rejected match requests will appear here.</p>
            </div>
          </div>
        </div>

      </div>

    </section>

  </section>
        </section>

  <!-- Matching chat popup - bottom right like Gmail compose -->
  <div id="matchingChatPopup" class="matching-chat-popup hidden">
    <div class="matching-chat-popup-header">
      <div class="popup-chat-user">
        <div id="popupChatAvatar" class="popup-chat-avatar">S</div>

        <div>
          <p>Study Buddy Chat</p>
          <h3 id="popupChatPartnerName">Study Partner</h3>
        </div>
      </div>

      <div class="popup-chat-controls">
        <button type="button" onclick="minimizeMatchingChatPopup(event)">−</button>
        <button type="button" onclick="closeMatchingChatPopup(event)">×</button>
      </div>
    </div>

    <div id="popupMessagesBox" class="popup-messages-box">
      <div class="popup-empty-chat">Open a chat to start messaging.</div>
    </div>

    <div id="popupSchedulePanel" class="popup-schedule-panel hidden">
      <div class="popup-schedule-head">
        <div>
          <p>Schedule Meeting</p>
          <h3>Choose meeting time</h3>
        </div>

        <button type="button" onclick="hidePopupSchedulePanel()">×</button>
      </div>

      <label for="popupScheduleDateTime">Meeting date and time</label>

      <input id="popupScheduleDateTime" type="datetime-local" />

      <div class="popup-schedule-actions">
        <button type="button" class="popup-cancel-btn" onclick="hidePopupSchedulePanel()">
          Cancel
        </button>

        <button type="button" class="popup-send-schedule-btn" onclick="submitPopupSchedule()">
          Send Schedule
        </button>
      </div>
    </div>

    <form id="popupChatForm" class="popup-chat-form">
      <input
        id="popupMessageInput"
        type="text"
        placeholder="Write your message..."
        maxlength="1000"
        autocomplete="off"
      />

      <button type="submit" class="popup-send-btn">Send</button>

      <button type="button" class="popup-schedule-btn" onclick="showPopupSchedulePanel()">
        Schedule
      </button>

      <button type="button" class="popup-match-now-btn" onclick="popupMatchNow()">
        Match Now
      </button>
    </form>
  </div>

  <button
    id="matchingChatMini"
    class="matching-chat-mini hidden"
    type="button"
    onclick="expandMatchingChatPopup()"
  >
    💬 Study Chat
  </button>

  <div class="toast" id="toast"></div>

  <div class="toast" id="toast"></div>

  <script>
    window.MATCHING_PAGE_DATA = {
      isLoggedIn: <%= user ? "true" : "false" %>
    };
  </script>

  <script src="/javaScript/matching.js?v=10"></script>
</body>
</html>