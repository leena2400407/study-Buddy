<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Study Buddy Chat</title>

  <link rel="stylesheet" href="/css/matching.css?v=chatpopup1" />
</head>

<body>
  <div class="chat-bg"></div>

  <button class="back-btn" type="button" onclick="window.location.href='/matching'">
    ← Back
  </button>

  <%
    const safeOtherUser =
      typeof otherUser !== "undefined" && otherUser
        ? otherUser
        : null;

    const partnerName =
      safeOtherUser && safeOtherUser.fullName
        ? safeOtherUser.fullName
        : safeOtherUser && safeOtherUser.username
          ? safeOtherUser.username
          : "Study Partner";

    const avatarLetter =
      partnerName && partnerName.length > 0
        ? partnerName.charAt(0).toUpperCase()
        : "S";
  %>

  <main class="chat-page">
    <section class="chat-shell">

      <header class="chat-header">
        <div class="chat-avatar">
          <%= avatarLetter %>
        </div>

        <div>
          <p class="small-title">STUDY BUDDY CHAT</p>

          <h1>
            <%= partnerName %>
          </h1>

          <p class="chat-subtitle">
            Private study chat between matched students.
          </p>
        </div>
      </header>

      <section id="messagesBox" class="messages-box">
        <div class="loading-message">
          Loading messages...
        </div>
      </section>

      <section id="schedulePanel" class="schedule-panel hidden">
        <div class="schedule-panel-head">
          <div>
            <p class="small-title">SCHEDULE MEETING</p>
            <h2>Choose meeting time</h2>
          </div>

          <button type="button" class="schedule-close-btn" onclick="hideSchedulePanel()">
            ×
          </button>
        </div>

        <label for="scheduleDateTime">Meeting date and time</label>

        <input
          id="scheduleDateTime"
          type="datetime-local"
        />

        <div class="schedule-actions">
          <button type="button" class="schedule-cancel-btn" onclick="hideSchedulePanel()">
            Cancel
          </button>

          <button type="button" class="schedule-send-btn" onclick="submitSchedule()">
            Send Schedule
          </button>
        </div>
      </section>

      <form id="chatForm" class="chat-form">
        <input
          id="messageInput"
          type="text"
          placeholder="Write your message..."
          maxlength="1000"
          autocomplete="off"
        />

        <button type="submit" class="send-btn">
          Send
        </button>

        <button type="button" class="schedule-btn" onclick="showSchedulePanel()">
          Schedule
        </button>

        <button type="button" class="match-now-btn" onclick="matchNow()">
          Match Now
        </button>
      </form>

    </section>
  </main>

  <script>
    window.CHAT_PAGE_DATA = {
      chatId: "<%= typeof chatId !== 'undefined' ? chatId : '' %>"
    };
  </script>

  <script src="/javaScript/matching-chat.js?v=3"></script>
</body>
</html>